    },
    "Waiting for playback — transcribing follows the episode. Turn on “Keep transcribing while paused” above to let it run ahead on its own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for playback — transcribing follows the episode. Turn on “Keep transcribing while paused” above to let it run ahead on its own."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待播放 —— 转写跟随单集进行。打开上方的「暂停时继续转写」可让它自行向前跑。"
          }
        }
