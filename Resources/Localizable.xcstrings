          "stringUnit": {
            "state": "translated",
            "value": "这会恢复示例节目、主讲人和播放列表。"
          }
        }
      }
    },
    "Throws away the stored transcript and starts over. Your corrections are kept — they're used as hints for the new pass.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Throws away the stored transcript and starts over. Your corrections are kept — they're used as hints for the new pass."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丢弃已保存的文稿并重新开始。你的修正会保留 —— 它们会作为新一轮转写的提示。"
          }
        }
      }
    },
    "Tip: create an IAM user scoped to read-only access on this bucket rather than reusing your main AWS credentials.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: create an IAM user scoped to read-only access on this bucket rather than reusing your main AWS credentials."
