    "Episodes download automatically the first time you play them, for offline replay. Remove one here to free up space — it re-downloads next time you play it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Episodes download automatically the first time you play them, for offline replay. Remove one here to free up space — it re-downloads next time you play it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单集会在首次播放时自动下载，以便离线重听。在这里移除可释放空间 — 下次播放时会重新下载。"
          }
        }
      }
    },
    "Estimated cost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
