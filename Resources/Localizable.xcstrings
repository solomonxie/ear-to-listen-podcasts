    },
    "Used to transcribe this speaker's episodes. Recognizers have to be told which language to expect — they can't work it out, and the wrong one returns confident nonsense rather than failing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to transcribe this speaker's episodes. Recognizers have to be told which language to expect — they can't work it out, and the wrong one returns confident nonsense rather than failing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于转写这位讲者的单集。识别器必须被告知语言 —— 它自己判断不出来，选错不会报错，只会输出看似自信的胡话。"
          }
        }
      }
    },
