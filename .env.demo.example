# Copy to .env.demo (gitignored). Non-Release builds (`make ios`) bundle these for demo
# mode; Release never does.

# A bucket the sample library connects to — s3, cos or oss.
DEMO_SOURCE_TYPE=s3
DEMO_SOURCE_LABEL=Demo Bucket
DEMO_SOURCE_BUCKET=
DEMO_SOURCE_REGION=
DEMO_SOURCE_ACCESS_KEY_ID=
DEMO_SOURCE_SECRET_ACCESS_KEY=
DEMO_SOURCE_FOLDER=

# An AI key — openai, anthropic, google, groq, mistral, deepseek or xai.
DEMO_AI_VENDOR=openai
DEMO_AI_KEY=
DEMO_AI_MODEL=
