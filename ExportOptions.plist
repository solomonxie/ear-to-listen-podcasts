<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. scripts/release-ios.sh copies this to /tmp and substitutes the team id
     from $DEVELOPMENT_TEAM, so a real account id never lands in git. -->
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <!-- Delivered by the export itself, through the Apple ID in Xcode > Settings >
         Accounts — no API key, no app-specific password, and no .ipa to carry by hand.
         `scripts/release-ios.sh` flips this to `export` when it's told to stop at the
         file instead. -->
    <key>destination</key>
    <string>upload</string>
    <key>teamID</key>
    <string>REPLACE_WITH_YOUR_TEAM_ID</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <!-- The entitlement points at the production container once the app is shipped;
         a Development export would back up into a container TestFlight can't see. -->
    <key>iCloudContainerEnvironment</key>
    <string>Production</string>
    <key>uploadSymbols</key>
    <true/>
    <key>stripSwiftSymbols</key>
    <true/>
    <!-- The build number is the timestamp the script passed in. Left to itself, Xcode
         picks its own and the upload no longer matches what was archived. -->
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
</dict>
</plist>
